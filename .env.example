# =============================================
# BookSphere - Environment Variables
# =============================================
# Copy this file to ".env" and adjust the values.
# The real .env file is private and never committed.
#
# Supported value types:
#   "true" / "false" -> real booleans
#   "null"           -> real null
#   everything else  -> string (quotes are stripped)

# --- Application ------------------------------------
APP_NAME="BookSphere"
APP_ENV=development
APP_DEBUG=true
APP_URL=http://localhost:8000

# Default timezone for all PHP date/time functions.
APP_TIMEZONE=UTC

# --- Session ----------------------------------------
SESSION_NAME=booksphere_session

# --- Database (SQLite) ------------------------------
# SQLite support is planned for a later phase.
# These settings are prepared now so no changes are
# needed in the future.
DB_CONNECTION=sqlite
DB_PATH=database/booksphere.db

# --- Email (Phase 9.5, OPTIONAL) --------------------
# The email notification module is off by default: the app works
# exactly the same without any of these values. To enable it:
#   1. EMAIL_ENABLED=true
#   2. keep EMAIL_TRANSPORT=log to write messages to
#      storage/logs/email.log instead of the network (great for
#      development), or set it to "smtp" for real delivery
#   3. fill in the SMTP_* values (credentials stay in .env,
#      which is never committed)
#
# Supported value types: see the header of this file.
EMAIL_ENABLED=false
EMAIL_FROM_ADDRESS=no-reply@booksphere.test
EMAIL_FROM_NAME=BookSphere

# "log" = write every message to storage/logs/email.log (no network).
# "smtp" = deliver through the SMTP server configured below.
EMAIL_TRANSPORT=log

# --- SMTP --------------------------------------------------
SMTP_HOST=localhost
SMTP_PORT=587
# none | tls (implicit TLS) | starttls (upgrade after EHLO)
SMTP_ENCRYPTION=starttls
SMTP_AUTH=false
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TIMEOUT=10
# Verify the server certificate during the TLS handshake (host name +
# chain). ON by default; set to false only for test servers without a
# valid certificate.
SMTP_VERIFY_PEER=true

# Queue the messages in the email_queue table and deliver them with
# a worker call (EmailNotificationService::processQueue()) instead of
# sending inline on the request.
EMAIL_QUEUE_ENABLED=false
EMAIL_QUEUE_BATCH=25

# --- Google Books API (Phase 10, OPTIONAL) --------------------
# The provider layer is off by default: the app works exactly the
# same without any of these values. To enable:
#   1. GOOGLE_BOOKS_ENABLED=true
#   2. (recommended) set GOOGLE_BOOKS_API_KEY to a Google Books API
#      key (https://developers.google.com/books) - without a key the
#      API still answers, but with much harder per-IP rate limits.
# The key stays in .env (never committed) and is used server-side only.
#
# Supported value types: see the header of this file.
GOOGLE_BOOKS_ENABLED=false
GOOGLE_BOOKS_API_KEY=

# HTTP client behaviour (timeout in seconds, retry count).
GOOGLE_BOOKS_TIMEOUT=10
GOOGLE_BOOKS_RETRIES=2

# Search caps: the API is never asked for more than this many results.
GOOGLE_BOOKS_MAX_RESULTS=20

# Preferred cover size ("small" | "thumbnail" | "small_zoom" | "medium").
GOOGLE_BOOKS_IMAGE_SIZE=thumbnail

# --- Cover download & cache (Phase 10.4, OPTIONAL) --------------------
# On import, each book's cover is downloaded once, validated, optimized
# (GD) and stored under public/assets/covers/google/ - the app then
# serves the local copy forever instead of asking Google again. Set
# GOOGLE_BOOKS_COVERS_ENABLED=false to keep the remote thumbnail URLs.
GOOGLE_BOOKS_COVERS_ENABLED=true
GOOGLE_BOOKS_COVER_TIMEOUT=10
GOOGLE_BOOKS_COVER_RETRIES=2
# How long a cached cover stays fresh before a re-fetch is attempted.
GOOGLE_BOOKS_COVER_CACHE_TTL=2592000
# Hard size limit for one downloaded cover (streaming abort).
GOOGLE_BOOKS_COVER_MAX_BYTES=5242880
